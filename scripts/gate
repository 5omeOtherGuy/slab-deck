#!/usr/bin/env bash
# The gate: everything a change must pass (lint, plugin validation, tests, secret scan). CI job `gate` runs it,
# and so does .githooks/pre-push. Quiet on success; on failure it names each failed step and prints its output.
# Needs the locked tools from `npm ci`, plus jq, shellcheck and git.
# shellcheck disable=SC2317 # cc and secrets run through step
set -uo pipefail
cd "$(dirname "$0")/.." || exit 1
bin=$PWD/node_modules/.bin
for c in jq shellcheck git; do
  command -v "$c" >/dev/null || { echo "gate: $c not found; install it (orbs: .agents/setup)"; exit 1; }
done
if [ ! -x "$bin/claude" ] || [ ! -x "$bin/secretlint" ]; then echo 'gate: locked tools missing; run npm ci'; exit 1; fi
if ! tmp=$(mktemp -d) || ! mkdir "$tmp/home"; then echo 'gate: cannot create a temporary directory'; exit 1; fi
trap 'rm -rf "$tmp"' EXIT
failed=0

step() { # name command…
  local name=$1; shift
  if ! "$@" >"$tmp/log" 2>&1; then printf 'gate: %s failed\n' "$name" >&2; cat "$tmp/log" >&2; failed=1; fi
}
# Claude Code from the lockfile, with no credentials and a throwaway HOME: never the real ~/.claude, never a model call.
cc() { env -i PATH="$bin:$PATH" HOME="$tmp/home" CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 claude "$@"; }
secrets() { git ls-files -z --cached --others --exclude-standard | xargs -0 "$bin/secretlint" --maskSecrets --; }

step shellcheck shellcheck statusline-slab.sh scripts/gate tests/statusline.sh .githooks/pre-push .agents/setup
step 'plugin validate' cc plugin validate --strict mod/slab-deck
step 'plugin tests' cc plugin test mod/slab-deck
step 'statusline tests' tests/statusline.sh
step 'secret scan' secrets
exit "$failed"
